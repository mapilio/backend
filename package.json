{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "mapilio-backend",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "node": "^22.12.0 || ^24.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "vite build",
        "build:api-docs": "node scripts/docs/build-api-reference.mjs",
        "test:imagery-upload-contract": "node --test scripts/docs/imagery-upload-contract.test.mjs",
        "test:gamification-badges-contract": "node --test scripts/docs/gamification-badges-contract.test.mjs",
        "test:mobile-onesignal-contract": "node --test scripts/docs/mobile-onesignal-identity-contract.test.mjs",
        "test:mobile-logout-contract": "node --test scripts/docs/mobile-logout-contract.test.mjs",
        "test:mobile-general-config-contract": "node --test scripts/docs/mobile-general-config-contract.test.mjs",
        "test:mobile-project-application-contract": "node --test scripts/docs/mobile-project-application-contract.test.mjs",
        "test:mobile-imagery-report-contract": "node --test scripts/docs/mobile-imagery-report-contract.test.mjs",
        "test:public-user-profile-contract": "node --test scripts/docs/public-user-profile-contract.test.mjs",
        "validate:api-examples": "node --test scripts/docs/validate-openapi-example-coverage.test.mjs scripts/docs/imagery-upload-contract.test.mjs scripts/docs/leaderboard-contract.test.mjs scripts/docs/leaderboard-winner-contract.test.mjs scripts/docs/user-uploads-contract.test.mjs scripts/docs/user-upload-details-contract.test.mjs scripts/docs/mobile-project-jobs-contract.test.mjs scripts/docs/mobile-project-application-contract.test.mjs scripts/docs/mobile-imagery-report-contract.test.mjs scripts/docs/public-user-profile-contract.test.mjs scripts/docs/organization-leaderboard-contract.test.mjs scripts/docs/marketplace-contract.test.mjs scripts/docs/inventory-types-contract.test.mjs scripts/docs/inventory-groups-contract.test.mjs scripts/docs/inventory-sprites-contract.test.mjs scripts/docs/inventory-retina-sprites-contract.test.mjs scripts/docs/mobile-public-token-contract.test.mjs scripts/docs/mobile-email-modal-contract.test.mjs scripts/docs/mobile-logout-contract.test.mjs scripts/docs/mobile-onesignal-identity-contract.test.mjs scripts/docs/mobile-general-config-contract.test.mjs scripts/docs/gamification-badges-contract.test.mjs && node scripts/docs/validate-openapi-example-coverage.mjs",
        "audit:public-content": "node --test scripts/security/audit-public-content.test.mjs && node scripts/security/audit-public-content.mjs --scope=all",
        "validate:geojson": "node scripts/geospatial/validate-geojson.mjs",
        "test:geojson-validator": "node --test scripts/geospatial/validate-geojson.test.mjs",
        "test:github-administrator-signing-readiness": "node --test scripts/governance/verify-github-administrator-signing-readiness.test.mjs",
        "check:github-administrator-signing-state": "node scripts/governance/verify-github-administrator-signing-readiness.mjs --expect=deferred",
        "check:license-state": "node --test scripts/governance/verify-license-state.test.mjs && node scripts/governance/verify-license-state.mjs",
        "check:markdown-links": "node --test scripts/docs/check-markdown-links.test.mjs && node scripts/docs/check-markdown-links.mjs",
        "check:api-docs": "npm run build:api-docs && git diff --exit-code -- public/docs/api",
        "dev": "vite",
        "lint:openapi": "redocly lint docs/api/openapi-v1.json --format=stylish"
    },
    "devDependencies": {
        "@redocly/cli": "^2.49.0",
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.20.0",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.2.2"
    },
    "overrides": {
        "js-yaml": "4.3.0"
    }
}
