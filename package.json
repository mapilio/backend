{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:api-docs": "node scripts/docs/build-api-reference.mjs",
        "audit:public-content": "node --test scripts/security/audit-public-content.test.mjs && node scripts/security/audit-public-content.mjs --scope=all",
        "check:api-docs": "npm run build:api-docs && git diff --exit-code -- public/docs/api",
        "dev": "vite",
        "lint:openapi": "redocly lint docs/api/openapi-v1.json --format=stylish"
    },
    "devDependencies": {
        "@redocly/cli": "^2.39.0",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "redoc": "2.5.3",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
