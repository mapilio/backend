APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated IP/CIDR list for the reverse proxies that directly form the trusted request chain.
# Wildcards and REMOTE_ADDR are rejected. Leave empty when requests reach PHP directly.
MAPILIO_TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Synthetic modern-schema fixtures. The seeder also requires APP_ENV=local and SQLite.
MAPILIO_DEMO_SEEDING_ENABLED=false

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MAPILIO_API_REQUEST_LOGGING_ENABLED=false
MAPILIO_API_SLOW_REQUEST_MS=1000

# Required by mapilio:verify-backup-readiness. Set policy values per deployed environment.
MAPILIO_BACKUP_EVIDENCE_PATH=
MAPILIO_BACKUP_EXPECTED_ENVIRONMENT=
MAPILIO_BACKUP_MAX_MANIFEST_AGE_MINUTES=
MAPILIO_BACKUP_MAX_AGE_HOURS=
MAPILIO_BACKUP_MAX_WAL_AGE_MINUTES=
MAPILIO_BACKUP_MAX_RESTORE_DRILL_AGE_DAYS=
MAPILIO_BACKUP_MAX_RPO_SECONDS=
MAPILIO_BACKUP_MAX_RTO_SECONDS=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

MAPILIO_LEGACY_DB_CONNECTION=legacy_pgsql
MAPILIO_LEGACY_DB_HOST=127.0.0.1
MAPILIO_LEGACY_DB_PORT=5432
MAPILIO_LEGACY_DB_DATABASE=legacy_mapilio
MAPILIO_LEGACY_DB_USERNAME=readonly_user
MAPILIO_LEGACY_DB_PASSWORD=
MAPILIO_LEGACY_DB_SSLMODE=prefer

# Disabled by default. Preflight reads only the explicitly listed legacy tables and writes restricted evidence.
MAPILIO_LEGACY_IMPORT_PREFLIGHT_ENABLED=false
MAPILIO_LEGACY_IMPORT_PREFLIGHT_TABLES=
MAPILIO_LEGACY_IMPORT_PREFLIGHT_OUTPUT_DIRECTORY=
MAPILIO_LEGACY_IMPORT_PREFLIGHT_CONNECT_TIMEOUT_SECONDS=5
MAPILIO_LEGACY_IMPORT_PREFLIGHT_STATEMENT_TIMEOUT_MS=5000
MAPILIO_LEGACY_IMPORT_PREFLIGHT_LOCK_TIMEOUT_MS=1000
MAPILIO_LEGACY_IMPORT_PREFLIGHT_MAX_RUNTIME_MS=30000
MAPILIO_IMPORT_SCHEMA_EXTRACTOR_ENABLED=false
MAPILIO_IMPORT_SCHEMA_SOURCE_CONNECTION=legacy_pgsql
MAPILIO_IMPORT_SCHEMA_SCHEMA=
MAPILIO_IMPORT_SCHEMA_TABLE=
MAPILIO_IMPORT_SCHEMA_OUTPUT_DIRECTORY=
MAPILIO_IMPORT_SCHEMA_CONNECT_TIMEOUT_SECONDS=5
MAPILIO_IMPORT_SCHEMA_STATEMENT_TIMEOUT_MS=5000
MAPILIO_IMPORT_SCHEMA_LOCK_TIMEOUT_MS=1000
MAPILIO_IMPORT_SCHEMA_MAX_RUNTIME_MS=30000
MAPILIO_TARGET_SCHEMA_EXTRACTOR_ENABLED=false
MAPILIO_TARGET_SCHEMA_CONNECTION=pgsql
MAPILIO_TARGET_SCHEMA_SCHEMA=
MAPILIO_TARGET_SCHEMA_TABLE=
MAPILIO_TARGET_SCHEMA_OUTPUT_DIRECTORY=
MAPILIO_TARGET_SCHEMA_CONNECT_TIMEOUT_SECONDS=5
MAPILIO_TARGET_SCHEMA_STATEMENT_TIMEOUT_MS=5000
MAPILIO_TARGET_SCHEMA_LOCK_TIMEOUT_MS=1000
MAPILIO_TARGET_SCHEMA_MAX_RUNTIME_MS=30000

MAPILIO_MOBILE_CONFIG_TOKEN=
MAPILIO_MOBILE_MARKET_OPEN=false
MAPILIO_MOBILE_CHALLENGE_OPEN=false
MAPILIO_MOBILE_CHALLENGE_DATES=2023-03-01,2023-05-31
MAPILIO_MOBILE_CHALLENGE_URL=https://mapilio.com
MAPILIO_MOBILE_SHOW_WEEK=true
MAPILIO_MOBILE_FACEBOOK_LOGIN_ENABLED=true
MAPILIO_MOBILE_GOOGLE_LOGIN_ENABLED=true
MAPILIO_MOBILE_APPLE_LOGIN_ENABLED=true
MAPILIO_MOBILE_OSM_LOGIN_ENABLED=true
MAPILIO_MOBILE_ANDROID_VERSION=1.0.56
MAPILIO_MOBILE_ANDROID_MIN_VERSION=0
MAPILIO_MOBILE_IOS_VERSION=1.2.0
MAPILIO_MOBILE_IOS_MIN_VERSION=0
MAPILIO_MOBILE_ANDROID_MAP_TOKEN=
MAPILIO_MOBILE_IOS_MAP_TOKEN=
MAPILIO_MOBILE_AUTH_CLIENT_ID=
MAPILIO_MOBILE_AUTH_CLIENT_SECRET=
MAPILIO_MOBILE_AUTH_SIGNING_KEY=
# Set only while rotating the signing key. Verification accepts this key too,
# so a rotation does not log out every mobile session. Clear it once the
# longest refresh token TTL has elapsed.
MAPILIO_MOBILE_AUTH_PREVIOUS_SIGNING_KEY=
# Enables the token revocation denylist. Adds one indexed lookup per
# authenticated request; revocations are recorded even while this is false.
MAPILIO_MOBILE_AUTH_REVOCATION_ENABLED=false
MAPILIO_MOBILE_ACCESS_TOKEN_TTL=3600
MAPILIO_MOBILE_REFRESH_TOKEN_TTL=36000
MAPILIO_MOBILE_AUTH_PASSWORD_RATE_LIMIT=10
MAPILIO_MOBILE_AUTH_REFRESH_RATE_LIMIT=30
MAPILIO_DEFAULT_PROFILE_PHOTO_URL=https://mapilio.com/app/default_avatar.png
MAPILIO_ONESIGNAL_REST_API_KEY=

MAPILIO_MAILCOACH_BASE_URL=
MAPILIO_MAILCOACH_API_TOKEN=
MAPILIO_MAILCOACH_LIST_ID=
MAPILIO_MAILCOACH_SKIP_CONFIRMATION=true
MAPILIO_MAILCOACH_CONNECT_TIMEOUT=3
MAPILIO_MAILCOACH_REQUEST_TIMEOUT=8

# Default API rate limit. Enable it to start observing: the limiter logs the
# callers it would reject without rejecting them. Only set ENFORCE=true after a
# full traffic cycle shows no legitimate consumer reaches the ceiling.
MAPILIO_API_RATE_LIMITING_ENABLED=false
MAPILIO_API_RATE_LIMITING_ENFORCE=false
MAPILIO_API_RATE_LIMIT_MAX_ATTEMPTS=300
MAPILIO_API_RATE_LIMIT_DECAY_SECONDS=60

# Ceiling for anonymous image-report text. Generous by design: real reports are
# a sentence or two, this only stops unbounded text reaching moderation.
MAPILIO_IMAGERY_REPORT_MAX_MESSAGE_LENGTH=2000
MAPILIO_IMAGERY_REPORT_RATE_LIMIT=10

# Resource guard for sequence metadata uploads. The ceiling sits well above the
# largest sequence observed in production (18,824 images) so no legitimate
# upload is rejected; rows are written in chunks of this size.
MAPILIO_IMAGERY_UPLOAD_MAX_POINTS=50000
MAPILIO_IMAGERY_UPLOAD_CHUNK_SIZE=500

MAPILIO_IMAGE_UPLOAD_SMOKE_ENABLED=false
MAPILIO_IMAGE_UPLOAD_SMOKE_BASE_URL=
MAPILIO_IMAGE_UPLOAD_SMOKE_ALLOWED_HOSTS=
MAPILIO_IMAGE_UPLOAD_SMOKE_CONNECT_TIMEOUT=3
MAPILIO_IMAGE_UPLOAD_SMOKE_REQUEST_TIMEOUT=20
MAPILIO_IMAGE_UPLOAD_SMOKE_CHUNK_SIZE=256
MAPILIO_IMAGE_UPLOAD_SMOKE_POLL_ATTEMPTS=10
MAPILIO_IMAGE_UPLOAD_SMOKE_POLL_DELAY_MS=500

MAPILIO_AI_PREDICTION_ENABLED=false
MAPILIO_AI_DISPATCH_AFTER_UPLOAD=false
MAPILIO_AI_PREDICTION_ENDPOINT=
MAPILIO_AI_PREDICTION_CONFIG_URL=
MAPILIO_AI_PREDICTION_TOKEN=
MAPILIO_AI_PREDICTION_QUEUE=prediction
MAPILIO_AI_CONNECT_TIMEOUT=5
MAPILIO_AI_REQUEST_TIMEOUT=30
MAPILIO_AI_RESERVATION_TTL=900

MAPILIO_AI_CALLBACK_ENABLED=false
MAPILIO_AI_CALLBACK_SIGNING_SECRET=
MAPILIO_AI_CALLBACK_TIMESTAMP_TOLERANCE=300
MAPILIO_AI_CALLBACK_NONCE_RETENTION=86400
MAPILIO_AI_CALLBACK_MAX_PAYLOAD_BYTES=5242880
MAPILIO_AI_CALLBACK_MAX_FEATURES=100000
MAPILIO_AI_CALLBACK_QUEUE=ai-callbacks

MAPILIO_AI_RESULT_PERSISTENCE_ENABLED=false
MAPILIO_AI_RESULT_PERSISTENCE_QUEUE=ai-results
MAPILIO_AI_MAX_MATCHES_PER_FEATURE=1000
MAPILIO_AI_MAX_ATTRIBUTES_BYTES=131072
MAPILIO_AI_MAX_SEGMENTATION_BYTES=1048576
MAPILIO_AI_FEATURE_API_CACHE_TTL=60
MAPILIO_AI_FEATURE_API_STALE_WHILE_REVALIDATE=300

MAPILIO_AI_STATUS_PROJECTION_ENABLED=false
MAPILIO_AI_STATUS_PROJECTION_QUEUE=ai-status-projections

MAPILIO_GEO_PUBLICATION_REGISTRATION_ENABLED=false
MAPILIO_GEO_PUBLICATION_PREPARATION_ENABLED=false
MAPILIO_GEO_PUBLICATION_DELIVERY_ENABLED=false
MAPILIO_GEO_PUBLICATION_QUEUE=geo-publications
MAPILIO_GEO_PUBLICATION_PREPARATION_QUEUE=geo-publication-preparation
MAPILIO_GEO_PUBLICATION_TARGET=canonical_ai_detections
MAPILIO_GEO_PUBLICATION_VIEW=mapilio_ai_features_v1
MAPILIO_GEO_PUBLICATION_LAYER=mapilio:ai_features_v1

MAPILIO_ADDRESS_ENRICHMENT_ENABLED=false
MAPILIO_ADDRESS_DISPATCH_AFTER_UPLOAD=false
MAPILIO_ADDRESS_PROVIDER_ENDPOINT=
MAPILIO_ADDRESS_PROVIDER_USER_AGENT=MapilioBackend/1.0
MAPILIO_ADDRESS_QUEUE=find-address
MAPILIO_ADDRESS_CONNECT_TIMEOUT=3
MAPILIO_ADDRESS_REQUEST_TIMEOUT=8
MAPILIO_ADDRESS_MAX_POINT_ATTEMPTS=3

MAPILIO_UKM_SCORING_ENABLED=false
MAPILIO_UKM_DISPATCH_AFTER_UPLOAD=false
MAPILIO_UKM_QUEUE=ukm-scoring
MAPILIO_UKM_HISTORY_MONTHS=6
MAPILIO_UKM_HEADING_TOLERANCE=45
MAPILIO_UKM_MIN_DISTANCE_METERS=1
MAPILIO_UKM_MAX_DISTANCE_METERS=40
MAPILIO_UKM_MAX_SCORE=5
MAPILIO_UKM_MAX_POINTS_PER_SEQUENCE=10000
MAPILIO_UKM_REQUIRE_SPATIAL_INDEX=true
MAPILIO_UKM_SPATIAL_INDEX=ix_imagery_ukm_geography_active

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660
# REDIS_QUEUE_RETRY_AFTER=660
# BEANSTALKD_QUEUE_RETRY_AFTER=660
# SQS_VISIBILITY_TIMEOUT=660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
