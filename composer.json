{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mapilio/backend",
    "type": "project",
    "description": "Modern Laravel backend foundation for the Mapilio platform.",
    "keywords": ["mapilio", "laravel", "imagery", "geospatial"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^3.0.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "conflict": {
        "guzzlehttp/guzzle": "<7.15.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "analyse:jobs": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Jobs --no-progress --memory-limit=1G",
        "analyse:ai-predictions": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/AiJobsPredictions --no-progress --memory-limit=1G",
        "analyse:geo-publishing": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/GeoPublishing --no-progress --memory-limit=1G",
        "analyse:identity-access": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/IdentityAccess --no-progress --memory-limit=1G",
        "analyse:imagery-reports": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/ImageryReports --no-progress --memory-limit=1G",
        "analyse:organizations": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/Organizations --no-progress --memory-limit=1G",
        "analyse:projects": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/Projects --no-progress --memory-limit=1G",
        "analyse:billing-catalog": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/BillingCatalog --no-progress --memory-limit=1G",
        "analyse:public-content": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/PublicContent --no-progress --memory-limit=1G",
        "analyse:gamification": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/Gamification --no-progress --memory-limit=1G",
        "analyse:imagery-uploads": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/ImageryUploads --no-progress --memory-limit=1G",
        "analyse:operations-dashboard": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/OperationsDashboard --no-progress --memory-limit=1G",
        "analyse:data-migration": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/DataMigration --no-progress --memory-limit=1G",
        "analyse:inventory-features": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/InventoryFeatures --no-progress --memory-limit=1G",
        "analyse:imagery-sequences": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --level=6 app/Domain/ImagerySequences --no-progress --memory-limit=1G",
        "format:test": "@php vendor/bin/pint --test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
