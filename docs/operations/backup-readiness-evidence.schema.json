{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapilio.com/schemas/backup-readiness-evidence-v1.json",
  "title": "Mapilio backup readiness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "generated_at",
    "database",
    "restore_drill"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$"
    },
    "generated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "status",
        "completed_at",
        "artifact_read_verified",
        "checksum_verified",
        "encrypted",
        "encryption_key_external",
        "offsite_copy_verified",
        "immutable_copy_verified",
        "pitr_enabled",
        "latest_wal_archived_at"
      ],
      "properties": {
        "engine": {
          "const": "postgresql"
        },
        "status": {
          "const": "success"
        },
        "completed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "artifact_read_verified": {
          "const": true
        },
        "checksum_verified": {
          "const": true
        },
        "encrypted": {
          "const": true
        },
        "encryption_key_external": {
          "const": true
        },
        "offsite_copy_verified": {
          "const": true
        },
        "immutable_copy_verified": {
          "const": true
        },
        "pitr_enabled": {
          "const": true
        },
        "latest_wal_archived_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "restore_drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_at",
        "target",
        "postgis_verified",
        "migration_state_verified",
        "integrity_checks_verified",
        "application_boot_verified",
        "measured_rpo_seconds",
        "measured_rto_seconds"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "completed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "target": {
          "const": "isolated-non-production"
        },
        "postgis_verified": {
          "const": true
        },
        "migration_state_verified": {
          "const": true
        },
        "integrity_checks_verified": {
          "const": true
        },
        "application_boot_verified": {
          "const": true
        },
        "measured_rpo_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "measured_rto_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
